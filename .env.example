# Copy to .env.local and fill in real values. .env.local is never committed.

# Resend API key (secret). Server-only. Never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_api_key_here

# Inbox that receives contact form messages. While the test sender is used,
# this must be the Resend account owner's address.
CONTACT_TO_EMAIL=you@example.com

# Sender address. Optional. Defaults to onboarding@resend.dev when unset.
CONTACT_FROM_EMAIL=onboarding@resend.dev

